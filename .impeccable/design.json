      "description": "Compact owned reaction with a tabular count.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\" aria-label=\"Fire, 1 reaction, your reaction\">🔥 <span>1</span></button>",
      "css": ".ds-chip{border:0;background:none;color:var(--rx-muted,#5b616b);border-radius:6px;min-height:28px;padding:4px 6px;display:inline-flex;gap:4px;align-items:center;justify-content:center;font-size:16px;cursor:pointer}.ds-chip span{font:12px/1.4 \"Geist Mono\",ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-chip:hover{background:var(--rx-wash,#eef0f2);color:var(--rx-ink,#121417)}.ds-chip[aria-pressed=true]{color:var(--rx-blue,#3b6fe0);background:var(--rx-wash,#eef0f2)}.ds-chip:focus-visible{outline:2px solid var(--rx-blue,#3b6fe0);outline-offset:2px}"
    },
