      "html": "<label for=\"ds-audience\">Public reactions</label><select class=\"ds-select\" id=\"ds-audience\"><option>Everyone</option><option>People I follow on dev-null</option></select>",
      "css": ".ds-select{width:100%;margin:8px 0;padding:10px;border:1px solid #8885;border-radius:6px;background:transparent;color:var(--ink,#121417);font:15px/1.6 Geist,system-ui,sans-serif}.ds-select:focus-visible{outline:2px solid var(--blue,#2e5ccb);outline-offset:3px}"
