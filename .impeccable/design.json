  "components": [
    {
      "name": "Install extension",
      "kind": "button",
      "refersTo": "button-install",
      "description": "Public-site installation link with the actual lime hover and focus treatments.",
      "html": "<a class=\"ds-install\" href=\"#\">Get the Chrome / Helium extension \u2197</a>",
      "css": ".ds-install{font:16px/1.6 Geist,system-ui,sans-serif;display:inline-block;background:#d9f66f;color:#17230f;padding:10px 18px;border-radius:6px;text-decoration:none;font-weight:600}.ds-install:hover{background:#c9e75d;color:#17230f}.ds-install:focus-visible{outline:2px solid var(--accent,#335d10);outline-offset:5px}"
    },
    {
      "name": "Connect GitHub",
      "kind": "button",
      "refersTo": "button-settings",
      "description": "Connection-settings action, including hover, focus and disabled states.",
      "html": "<button class=\"ds-connect\">Connect GitHub</button>",
      "css": ".ds-connect{font:600 15px/1.6 Geist,system-ui,sans-serif;border:0;border-radius:6px;background:var(--blue,#2e5ccb);color:var(--bg,#f6f7f8);padding:9px 16px;cursor:pointer}.ds-connect:hover{filter:brightness(.93)}.ds-connect:focus-visible{outline:2px solid var(--blue,#2e5ccb);outline-offset:3px}.ds-connect:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Connection-settings action, including hover, focus and disabled states.",
      "html": "<button class=\"ds-secondary\">Refresh repositories</button>",
      "css": ".ds-secondary{font:600 15px/1.6 Geist,system-ui,sans-serif;border:0;border-radius:6px;background:var(--wash,#eef0f2);color:var(--ink,#121417);padding:9px 16px;cursor:pointer}.ds-secondary:hover{filter:brightness(.93)}.ds-secondary:focus-visible{outline:2px solid var(--blue,#2e5ccb);outline-offset:3px}.ds-secondary:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "View profile",
      "kind": "button",
      "refersTo": "button-profile",
      "description": "Public-site submit button.",
      "html": "<button class=\"ds-profile-button\">View profile</button>",
      "css": ".ds-profile-button{font:16px/1.6 Geist,system-ui,sans-serif;background:var(--ink,#121417);color:var(--bg,#f6f7f8);border:0;border-radius:6px;padding:10px 16px;cursor:pointer}.ds-profile-button:hover{opacity:.85}.ds-profile-button:focus-visible{outline:2px solid var(--accent,#335d10);outline-offset:5px}"
    },
    {
      "name": "Profile handle field",
      "kind": "input",
      "refersTo": "input-profile",
      "description": "Labeled public profile lookup field.",
      "html": "<label class=\"ds-label\" for=\"ds-handle\">Find a public reaction profile</label><input class=\"ds-input\" id=\"ds-handle\" placeholder=\"GitHub handle\" maxlength=\"39\" autocomplete=\"off\">",
      "css": ".ds-label{font:16px/1.6 Geist,system-ui,sans-serif;display:block;font-weight:600;margin-bottom:8px;color:var(--ink,#121417)}.ds-input{font:16px/1.6 Geist,system-ui,sans-serif;background:var(--surface,#fff);color:var(--ink,#121417);padding:10px 12px;border:1px solid var(--line,#d3d7dd);border-radius:6px;min-width:0;caret-color:var(--accent,#335d10)}.ds-input:focus-visible{outline:2px solid var(--accent,#335d10);outline-offset:5px}"
    },
    {
      "name": "Site filter navigation",
      "kind": "nav",
      "refersTo": "filter-active",
      "description": "Public profile filters; active state is carried by aria-current.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Filter by site\"><a href=\"#\" aria-current=\"true\">All</a><a href=\"#\">dev-null</a><a href=\"#\">X</a><a href=\"#\">LinkedIn</a></nav>",
      "css": ".ds-nav{display:flex;gap:8px;flex-wrap:wrap}.ds-nav a{font:14px/1.6 Geist,system-ui,sans-serif;color:var(--ink,#121417);padding:5px 12px;text-decoration:none;border-radius:6px}.ds-nav a:hover{color:var(--accent,#335d10)}.ds-nav a[aria-current=true]{background:var(--ink,#121417);color:var(--bg,#f6f7f8)}.ds-nav a:focus-visible{outline:2px solid var(--accent,#335d10);outline-offset:5px}"
    },
    {
      "name": "Reaction chip",
      "kind": "chip",
      "refersTo": "chip-reaction",
      "description": "Selected reaction with tabular count, hover wash, and accessible ownership label.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\" aria-label=\"\ud83d\ude80, 3 reactions, yours. Remove reaction\">\ud83d\ude80 <span>3</span></button>",
      "css": ".ds-chip{font:16px/1.45 Geist,system-ui,sans-serif;border:0;background:none;color:var(--rx-muted,#5b616b);border-radius:6px;min-height:28px;padding:4px 6px;display:inline-flex;gap:4px;align-items:center;justify-content:center;cursor:pointer}.ds-chip span{font:12px/1.4 \"Geist Mono\",ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-chip:hover{background:var(--rx-wash,#eef0f2);color:var(--rx-ink,#121417)}.ds-chip[aria-pressed=true]{color:var(--rx-blue,#3b6fe0);background:var(--rx-wash,#eef0f2)}.ds-chip:focus-visible{outline:2px solid var(--rx-blue,#3b6fe0);outline-offset:2px}.ds-chip:disabled{opacity:.55;cursor:wait}"
    },
    {
      "name": "Visibility switch",
      "kind": "custom",
      "refersTo": "picker",
      "description": "Exact Public / Private labels; the selected segment retains its inherited translucent fill and small shadow.",
      "html": "<div class=\"ds-visibility\" role=\"group\" aria-label=\"Reaction visibility\"><button aria-pressed=\"true\">Public</button><button aria-pressed=\"false\">Private</button></div><p class=\"ds-scope\">Visible on your public reacji.to profile.</p>",
      "css": ".ds-visibility{display:flex;margin:0 12px;border:1px solid var(--border,#ddd);border-radius:6px;padding:3px;gap:3px;color:var(--rx-ink,#121417)}.ds-visibility button{font:14px/1.45 Geist,system-ui,sans-serif;flex:1;padding:6px 12px;border:0;border-radius:4px;background:transparent;color:inherit;cursor:pointer}.ds-visibility button[aria-pressed=true]{background:#7772;font-weight:600;box-shadow:0 1px 2px #0001}.ds-visibility button:focus-visible{outline:2px solid var(--rx-blue,#3b6fe0);outline-offset:2px}.ds-visibility button:disabled{opacity:.55;cursor:wait}.ds-scope{font:11px/1.45 Geist,system-ui,sans-serif;margin:8px 14px;opacity:.75;color:var(--rx-ink,#121417)}"
    },
    {
      "name": "Picker surface",
      "kind": "card",
      "refersTo": "picker",
      "description": "Static surface preview showing the actual title, close control and search field; live positioning and behavior are documented in DESIGN.md.",
      "html": "<section class=\"ds-picker\" aria-label=\"Choose a reaction\"><div class=\"ds-head\"><strong>reacji-to</strong><button class=\"ds-close\" aria-label=\"Close reactions\">\u00d7</button></div><div class=\"ds-controls\"><input class=\"ds-search\" aria-label=\"Search or paste any emoji\" placeholder=\"Search or paste any emoji\"></div></section>",
      "css": ".ds-picker{font:14px/1.45 Geist,system-ui,sans-serif;width:min(348px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;background:var(--rx-bg,#fff);color:var(--rx-ink,#121417);border:1px solid var(--rx-line,#e1e4e8);border-radius:12px}.ds-head{display:flex;align-items:center;justify-content:space-between;padding:12px 14px 6px}.ds-head strong{font-size:15px;font-weight:600}.ds-close{border:0;background:none;color:var(--rx-muted,#5b616b);border-radius:4px;width:28px;height:28px;font-size:22px;line-height:1;cursor:pointer}.ds-close:hover{background:var(--rx-wash,#eef0f2)}.ds-controls{padding:0 14px 10px}.ds-search{font:inherit;width:100%;max-width:100%;padding:9px 10px;background:var(--rx-bg,#fff);color:var(--rx-ink,#121417);border:1px solid var(--rx-line,#e1e4e8);border-radius:6px;caret-color:var(--rx-blue,#3b6fe0)}.ds-search::placeholder{color:var(--rx-muted,#5b616b)}.ds-close:focus-visible,.ds-search:focus-visible{outline:2px solid var(--rx-blue,#3b6fe0);outline-offset:2px}"
    },
    {
      "name": "Public reaction row",
      "kind": "custom",
