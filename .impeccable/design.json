    }
  ],
  "narrative": {
    "northStar": "A small sideways glance",
    "overview": "The extension stays compact, readable, and close to the host site's native controls. Its approved photorealistic eyes provide a small expressive detail: glossy off-white oval eyeballs, vivid blue irises, black pupils, and a sideways gaze on transparency. The reacji-to wordmark accompanies the eyes in settings; the embedded trigger uses the small asset.\n\nThis document owns the extension picker, reaction chips, generic webpage placement toolbar, and connection settings. Website composition and public profile styling belong to `reacji-to/reacji-to-web` and its own `DESIGN.md`. This is an extraction of the established implementation, not a new visual direction. Sources are `src/content.css`, `src/content.js`, `src/options.css`, `src/options.html`, `src/options.js`, and `src/brand.js`. Reviewed evidence is `.impeccable/review/settings-desktop.png`, `.impeccable/review/settings-mobile.png`, and `artifacts/web-placement.png`; earlier picker and logo size captures remain in `artifacts/`.",
    "keyCharacteristics": [
      "Compact transparent blue-eyed identity.",
      "Native density, restrained type, neutral surfaces, and blue actions.",
      "Host-aware picker colors and automatic light/dark settings.",
      "Explicit Public / Private state and visible keyboard focus.",
      "Page placements attached beneath their target with a short stem."
    ],
    "rules": [
      {
        "name": "Native Color",
        "body": "Preserve the picker's host-token inheritance and existing blue actions; website lime does not recolor extension controls.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the transparent photorealistic blue-eyed asset and reacji-to wordmark.",
      "**Do** preserve host color inheritance, native-sized controls, and visible keyboard focus.",
      "**Do** keep page toolbars outside their target content, with the stem and horizontal viewport clamping.",
      "**Do** keep Public / Private and audience filtering visibly distinct.",
      "**Do** preserve dark-theme mappings and the reduced-motion condition on picker entry."
    ],
    "donts": [
      "**Don't** import website lime, oversized hero type, or marketing layouts into the extension.",
      "**Don't** imply that audience filtering changes a reaction's privacy.",
      "**Don't** imply that switching visibility moves or erases the other stored reaction.",
      "**Don't** assume Geist is bundled or replace platform emoji with a new icon set."
    ]
  }
}
