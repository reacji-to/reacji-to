      "css": ".ds-visibility{display:flex;border:1px solid var(--border,#ddd);border-radius:6px;padding:3px;gap:3px;color:var(--rx-ink,#121417)}.ds-visibility button{flex:1;padding:6px 12px;border:0;border-radius:4px;background:transparent;color:inherit;cursor:pointer;font:14px/1.45 Geist,system-ui,sans-serif}.ds-visibility button[aria-pressed=true]{background:#7772;font-weight:600;box-shadow:0 1px 2px #0001}.ds-visibility button:focus-visible{outline:2px solid var(--rx-blue,#3b6fe0);outline-offset:2px}"
